{
  "entities": {
    "VpnConfig": {
      "title": "VPN Configuration",
      "description": "A VPN client configuration profile (VLESS, VMess, Trojan, Shadowsocks)",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner user ID" },
        "name": { "type": "string", "description": "Config display label" },
        "protocol": { "type": "string", "description": "Protocol: vless, vmess, trojan, or shadowsocks" },
        "server": { "type": "string", "description": "Server address or hostname" },
        "port": { "type": "integer", "description": "Port number" },
        "uuidOrPassword": { "type": "string", "description": "Authentication UUID or password" },
        "transport": { "type": "string", "description": "Transport protocol: tcp, ws, grpc, h2" },
        "security": { "type": "string", "description": "Security layer: tls, reality, none" },
        "sni": { "type": "string", "description": "Server Name Indication" },
        "pathOrServiceName": { "type": "string", "description": "WebSocket path or gRPC service name" },
        "rawConfig": { "type": "string", "description": "Raw URI or encrypted config" },
        "pingMs": { "type": "integer", "description": "Last tested latency in milliseconds (-1 for offline)" },
        "status": { "type": "string", "description": "Status: online, offline, untested" },
        "isFavorite": { "type": "boolean", "description": "Flag for favorite config" },
        "origin": { "type": "string", "description": "Source category: USER_IMPORTED, SUBSCRIPTION_ASSIGNED, SYSTEM_MANAGED" },
        "subscriptionId": { "type": "string", "description": "Linked subscription ID when origin is SUBSCRIPTION_ASSIGNED" },
        "endpointId": { "type": "string", "description": "Linked inventory endpoint ID" },
        "allocationVersion": { "type": "integer", "description": "Allocation version number" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp via serverTimestamp" }
      },
      "required": ["userId", "name", "protocol", "server", "port", "uuidOrPassword", "rawConfig", "createdAt", "updatedAt"]
    },
    "VpnServer": {
      "title": "VPN Node Server",
      "description": "A VPN server infrastructure node monitored for health and latency",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner user ID" },
        "name": { "type": "string", "description": "Server name" },
        "country": { "type": "string", "description": "Country name" },
        "countryCode": { "type": "string", "description": "Country code (e.g. DE, FI, US)" },
        "host": { "type": "string", "description": "Server IP address or hostname" },
        "port": { "type": "integer", "description": "Port number" },
        "protocol": { "type": "string", "description": "Primary protocol supported" },
        "status": { "type": "string", "description": "Status: online, offline, maintenance" },
        "latencyMs": { "type": "integer", "description": "Last latency check result in milliseconds" },
        "uptimePercentage": { "type": "number", "description": "Uptime percentage (0.0 to 100.0)" },
        "bandwidthUsageGb": { "type": "number", "description": "Bandwidth usage in Gigabytes" },
        "bandwidthLimitGb": { "type": "number", "description": "Bandwidth limit in Gigabytes" },
        "activeUsers": { "type": "integer", "description": "Number of connected users" },
        "stabilityScore": { "type": "integer", "description": "Calculated stability score (0-100)" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp via serverTimestamp" }
      },
      "required": ["userId", "name", "country", "countryCode", "host", "port", "protocol", "status", "createdAt", "updatedAt"]
    },
    "FailoverPolicy": {
      "title": "Failover Policy",
      "description": "Automated server failover and intelligent routing configuration",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner user ID" },
        "name": { "type": "string", "description": "Policy title" },
        "primaryServerId": { "type": "string", "description": "Primary server ID" },
        "backupServerId": { "type": "string", "description": "Backup server ID" },
        "latencyThresholdMs": { "type": "integer", "description": "Threshold latency in ms before failover" },
        "autoSwitchEnabled": { "type": "boolean", "description": "Whether automated failover is active" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["userId", "name", "primaryServerId", "backupServerId", "latencyThresholdMs", "autoSwitchEnabled", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User account status, RBAC role, and quota details",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User identifier matching auth.uid" },
        "displayName": { "type": "string", "description": "User display name" },
        "email": { "type": "string", "description": "User email address" },
        "role": { "type": "string", "description": "RBAC Role: user, SUPER_ADMIN, SERVER_MANAGER, USER_ADMIN, AUDITOR" },
        "deviceCount": { "type": "integer", "description": "Currently active registered devices" },
        "maxDevices": { "type": "integer", "description": "Maximum device limit" },
        "dataUsageBytes": { "type": "number", "description": "Bandwidth consumed in bytes" },
        "dataLimitBytes": { "type": "number", "description": "Bandwidth quota in bytes" },
        "subscriptionStatus": { "type": "string", "description": "Subscription status: active, expired, trial" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Profile creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Profile update timestamp" }
      },
      "required": ["userId", "displayName", "email", "role", "subscriptionStatus", "createdAt", "updatedAt"]
    },
    "AuthAuditLog": {
      "title": "Authentication & RBAC Audit Log",
      "description": "Audit entry recording admin authentication attempts, session events, and RBAC actions",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Admin UID" },
        "action": { "type": "string", "description": "Event action name" },
        "role": { "type": "string", "description": "Active role" },
        "module": { "type": "string", "description": "Target module" },
        "status": { "type": "string", "description": "SUCCESS, FAILED, or LOCKED_OUT" },
        "ipOrDevice": { "type": "string", "description": "Client IP address or device identifier" },
        "details": { "type": "string", "description": "Audit details or error reason" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of event" }
      },
      "required": ["userId", "action", "role", "module", "status", "createdAt"]
    },
    "UserSubscription": {
      "title": "User Subscription",
      "description": "Server-controlled user subscription plan, entitlement state, and rotation version",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase UID" },
        "userEmail": { "type": "string", "description": "Owner email for admin lookup" },
        "planId": { "type": "string", "description": "Plan ID: plan_1m, plan_3m, plan_1y" },
        "planDurationDays": { "type": "integer", "description": "Plan duration in days (30, 90, 365)" },
        "endpointAllocationLimit": { "type": "integer", "description": "Daily dedicated IP endpoint quota (5, 15, 50)" },
        "startDate": { "type": "string", "format": "date-time", "description": "Trusted activation timestamp" },
        "expirationDate": { "type": "string", "format": "date-time", "description": "Trusted expiration timestamp" },
        "status": { "type": "string", "description": "PENDING_PAYMENT, ACTIVE, EXPIRED, SUSPENDED, CANCELLED" },
        "paymentStatus": { "type": "string", "description": "UNPAID, PENDING_VERIFICATION, CONFIRMED, FAILED, REFUNDED" },
        "lastDailyRotation": { "type": "string", "format": "date-time", "description": "Last daily rotation timestamp" },
        "lastRotationCycleKey": { "type": "string", "description": "UTC date key YYYY-MM-DD for idempotent daily rotation" },
        "currentAllocationVersion": { "type": "integer", "description": "Monotonic allocation version" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update server timestamp" }
      },
      "required": ["userId", "planId", "planDurationDays", "endpointAllocationLimit", "status", "paymentStatus", "currentAllocationVersion", "createdAt", "updatedAt"]
    },
    "ManagedEndpoint": {
      "title": "Central Managed Endpoint",
      "description": "Central healthy endpoint pool entry with exclusive ownership tracking and zero private credentials",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "country": { "type": "string" },
        "countryCode": { "type": "string" },
        "host": { "type": "string" },
        "port": { "type": "integer" },
        "protocol": { "type": "string" },
        "transport": { "type": "string" },
        "security": { "type": "string" },
        "sni": { "type": "string" },
        "pathOrServiceName": { "type": "string" },
        "enabled": { "type": "boolean" },
        "healthy": { "type": "boolean" },
        "priorityTier": { "type": "integer" },
        "latencyMs": { "type": "integer" },
        "stabilityScore": { "type": "integer" },
        "assignedUserId": { "type": "string" },
        "assignedSubscriptionId": { "type": "string" },
        "allocationExpiresAt": { "type": "string", "format": "date-time" },
        "failureCount": { "type": "integer" },
        "cooldownUntil": { "type": "string", "format": "date-time" },
        "lastHealthCheckAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "countryCode", "host", "port", "protocol", "enabled", "healthy", "priorityTier", "assignedUserId", "createdAt", "updatedAt"]
    },
    "AllocatedEndpointRecord": {
      "title": "Private Allocated Endpoint",
      "description": "User-isolated dedicated endpoint allocation with user credential token",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subscriptionId": { "type": "string" },
        "endpointId": { "type": "string" },
        "endpointName": { "type": "string" },
        "country": { "type": "string" },
        "countryCode": { "type": "string" },
        "host": { "type": "string" },
        "port": { "type": "integer" },
        "protocol": { "type": "string" },
        "transport": { "type": "string" },
        "security": { "type": "string" },
        "sni": { "type": "string" },
        "pathOrServiceName": { "type": "string" },
        "credentialToken": { "type": "string" },
        "rawConfig": { "type": "string" },
        "allocationVersion": { "type": "integer" },
        "cycleKey": { "type": "string" },
        "allocationStatus": { "type": "string" },
        "healthy": { "type": "boolean" },
        "latencyMs": { "type": "integer" },
        "allocatedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "subscriptionId", "endpointId", "host", "port", "protocol", "credentialToken", "rawConfig", "allocationVersion", "allocationStatus", "updatedAt"]
    },
    "SubscriptionHistoryEvent": {
      "title": "Subscription History Event",
      "description": "Immutable subscription lifecycle audit event",
      "type": "object",
      "properties": {
        "subscriptionId": { "type": "string" },
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "fromPlanId": { "type": "string" },
        "toPlanId": { "type": "string" },
        "statusAfter": { "type": "string" },
        "actorId": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subscriptionId", "userId", "action", "statusAfter", "actorId", "createdAt"]
    },
    "AllocationHistoryRecord": {
      "title": "Allocation History Record",
      "description": "Immutable per-user dedicated endpoint allocation, rotation, failure, cooldown, and revocation log",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subscriptionId": { "type": "string" },
        "planId": { "type": "string" },
        "endpointId": { "type": "string" },
        "endpointName": { "type": "string" },
        "host": { "type": "string" },
        "port": { "type": "integer" },
        "protocol": { "type": "string" },
        "action": { "type": "string" },
        "allocationVersion": { "type": "integer" },
        "cycleKey": { "type": "string" },
        "reason": { "type": "string" },
        "actorId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "subscriptionId", "endpointId", "action", "allocationVersion", "actorId", "createdAt"]
    },
    "PaymentRequestRecord": {
      "title": "Payment Verification Request",
      "description": "User-submitted payment intent awaiting trusted backend/admin verification",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "subscriptionId": { "type": "string" },
        "planId": { "type": "string" },
        "actionType": { "type": "string" },
        "provider": { "type": "string" },
        "referenceCode": { "type": "string" },
        "status": { "type": "string" },
        "note": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "verifiedBy": { "type": "string" }
      },
      "required": ["userId", "planId", "actionType", "status", "createdAt"]
    },
    "InventoryShortageAlert": {
      "title": "Inventory Shortage Alert",
      "description": "Admin alert emitted when healthy inventory cannot satisfy an active user quota",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subscriptionId": { "type": "string" },
        "planId": { "type": "string" },
        "requestedCount": { "type": "integer" },
        "allocatedCount": { "type": "integer" },
        "shortfallCount": { "type": "integer" },
        "cycleKey": { "type": "string" },
        "reason": { "type": "string" },
        "resolved": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "subscriptionId", "planId", "requestedCount", "allocatedCount", "shortfallCount", "cycleKey", "resolved", "createdAt"]
    },
    "RotationAuditLog": {
      "title": "Rotation Scheduler Audit Log",
      "description": "Immutable log of daily or manual endpoint rotation operations",
      "type": "object",
      "properties": {
        "cycleKey": { "type": "string" },
        "triggerMode": { "type": "string" },
        "triggeredByUid": { "type": "string" },
        "targetUserCount": { "type": "integer" },
        "rotatedUsersCount": { "type": "integer" },
        "replacedEndpointsCount": { "type": "integer" },
        "shortageCount": { "type": "integer" },
        "status": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["cycleKey", "triggerMode", "triggeredByUid", "status", "createdAt"]
    },
    "AdminRecord": {
      "title": "Authorized Admin Record",
      "description": "Admin registry document used by Firestore rules",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "role", "createdAt"]
    },
    "SupportTicket": {
      "title": "TMS NEXUS AI Support Ticket",
      "description": "User support ticket with optional AI triage summary and admin status tracking",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "subject": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "description": { "type": "string" },
        "aiTriageSummary": { "type": "string" },
        "lastReplyText": { "type": "string" },
        "lastReplyByRole": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "subject", "category", "priority", "status", "description", "createdAt", "updatedAt"]
    },
    "SupportTicketReply": {
      "title": "Support Ticket Reply",
      "description": "Append-only message inside a support ticket conversation",
      "type": "object",
      "properties": {
        "ticketId": { "type": "string" },
        "userId": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderRole": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ticketId", "userId", "senderUid", "senderRole", "message", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": "AdminRecord",
      "description": "Authorized administrator registry"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile and quota metadata"
    },
    "/users/{userId}/vpn_configs/{configId}": {
      "schema": "VpnConfig",
      "description": "VPN configurations owned by the user (user-imported, subscription-assigned, system-managed)"
    },
    "/users/{userId}/vpn_servers/{serverId}": {
      "schema": "VpnServer",
      "description": "VPN servers monitored and managed by the user"
    },
    "/users/{userId}/failover_policies/{policyId}": {
      "schema": "FailoverPolicy",
      "description": "Failover routing policies owned by the user"
    },
    "/users/{userId}/audit_logs/{logId}": {
      "schema": "AuthAuditLog",
      "description": "Security and RBAC audit logs"
    },
    "/users/{userId}/allocated_endpoints/{allocationId}": {
      "schema": "AllocatedEndpointRecord",
      "description": "Private per-user dedicated IP endpoint allocations with user credentials"
    },
    "/users/{userId}/subscription_history/{eventId}": {
      "schema": "SubscriptionHistoryEvent",
      "description": "User subscription lifecycle audit trail"
    },
    "/users/{userId}/allocation_history/{historyId}": {
      "schema": "AllocationHistoryRecord",
      "description": "Immutable dedicated endpoint allocation, rotation, cooldown, and revocation history per user"
    },
    "/subscriptions/{subscriptionId}": {
      "schema": "UserSubscription",
      "description": "Central server-verified user subscriptions"
    },
    "/endpoint_inventory/{endpointId}": {
      "schema": "ManagedEndpoint",
      "description": "Central healthy endpoint pool with exclusivity lock and zero private credentials"
    },
    "/payment_requests/{paymentId}": {
      "schema": "PaymentRequestRecord",
      "description": "User payment verification requests confirmed only by trusted admin/backend"
    },
    "/shortage_alerts/{alertId}": {
      "schema": "InventoryShortageAlert",
      "description": "Administrator alerts for insufficient healthy endpoints"
    },
    "/rotation_logs/{logId}": {
      "schema": "RotationAuditLog",
      "description": "Append-only daily and manual rotation audit logs"
    },
    "/support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "User support tickets with AI triage and admin reply tracking"
    },
    "/support_tickets/{ticketId}/replies/{replyId}": {
      "schema": "SupportTicketReply",
      "description": "Immutable replies within a support ticket thread"
    }
  }
}
